<% content_for :title, "Vérifier mon identité" %>
<%= account_page_heading "Confirmer votre mot de passe" %><p>Cette confirmation est demandée pour une opération sensible sur votre compte.</p>
<%= form_with url: account_reauthentication_path do |form| %><div class="form-field"><%= form.label :password, "Mot de passe" %><div class="password-control" data-controller="password-visibility"><%= form.password_field :password, class: "control", autocomplete: "current-password", required: true, data: { password_visibility_target: "input" } %><%= render "shared/password_toggle", input_id: form.field_id(:password) %></div></div><%= form.submit "Confirmer", class: "btn btn-deep" %><% end %>
