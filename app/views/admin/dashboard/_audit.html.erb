<section id="journal-audit" class="admin-audit-overview">
  <div class="network-section-heading"><div><span class="account-eyebrow">Traçabilité</span><h2>Journal d’audit</h2><p>Les événements administratifs sont conservés sans modification ni suppression.</p></div><span class="network-total"><strong><%= @audit_total %></strong> événements</span></div>
  <%= form_with url: admin_root_path(tab: "audit"), method: :get, class: "admin-filter-bar" do |form| %><%= hidden_field_tag :tab, "audit", id: nil %><%= hidden_field_tag :period, @activity.days, id: nil %><%= select_field form, :audit_event, "Action", [["Changement de rôle", "user.role_changed"], ["Promotion administrateur", "user.promoted_admin"], ["Ajustement de points", "points.adjustment"], ["Permission attribuée", "permission.granted"], ["Permission révoquée", "permission.revoked"]], include_blank: "Toutes", selected: params[:audit_event] %><%= form.submit "Filtrer le journal", class: "btn btn-deep" %><% end %>
  <div class="card table-scroll" tabindex="0" role="region" aria-label="Événements du journal d’audit"><table><thead><tr><th>Date</th><th>Acteur</th><th>Action</th><th>Cible</th><th>Motif</th></tr></thead><tbody><% @audit_logs.each do |log| %><tr><td><%= l log.created_at, format: :short %></td><td>#<%= log.actor_id %></td><td><%= t("audit_actions.#{log.action}", default: log.action.humanize) %></td><td><%= log.target_type %> #<%= log.target_id %></td><td><%= log.reason %></td></tr><% end %></tbody></table><% if @audit_total.zero? %><p class="empty-state">Aucun événement enregistré.</p><% end %></div>
  <% audit_pages = [(@audit_total / 20.0).ceil, 1].max %><% if audit_pages > 1 %><nav class="pagination" aria-label="Pagination du journal d’audit"><% (1..audit_pages).each do |number| %><%= link_to number, admin_root_path(tab: "audit", period: @activity.days, audit_event: params[:audit_event], audit_page: number), aria: ({ current: "page" } if number == @audit_page) %><% end %></nav><% end %>
</section>
