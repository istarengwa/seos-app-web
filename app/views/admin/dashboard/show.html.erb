<% content_for :title, "Vue d’ensemble" %>
<div class="admin-console admin-overview-page" data-controller="workspace-tabs" data-workspace-tabs-default-value="<%= @active_tab %>">
  <header class="admin-console-heading admin-dashboard-hero"><div><span class="account-eyebrow"><%= current_user.super_admin? ? "Super administration" : "Modération et accompagnement" %></span><h1>Vue d’ensemble</h1><p>Suivez l’activité, retrouvez vos outils et consultez les décisions de l’équipe.</p></div><span class="admin-hero-mark" aria-hidden="true"><%= admin_ui_icon("network") %></span></header>
  <nav class="workspace-tabs admin-overview-tabs" aria-label="Rubriques de la vue d’ensemble" data-workspace-tabs-target="navigation">
    <% @overview_tabs.each do |key, label| %>
      <%= link_to label, admin_root_path(tab: key, period: @activity.days), id: "workspace-tab-#{key}", data: { workspace_tabs_target: "tab", key: key, action: "workspace-tabs#select keydown->workspace-tabs#keyboard" } %>
    <% end %>
  </nav>
  <% @overview_tabs.each do |key, label| %>
    <%= tag.section id: "workspace-#{key}", hidden: key != @active_tab, data: { workspace_tabs_target: "panel", key: key }, aria: { label: label } do %>
      <%= render(key == "activity" ? "activity" : key, activity: @activity) %>
    <% end %>
  <% end %>
</div>
