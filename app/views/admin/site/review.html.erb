<main class="studio-review" data-controller="studio-review" data-studio-review-width-value="<%= @preview_width.to_i %>" data-turbo="false">
  <h1 class="sr-only">Vérifier avant de mettre en ligne</h1>
  <header class="studio-review-bar" aria-label="Vérification de la page">
    <%= link_to "← Revenir aux modifications", builder_admin_site_path(@version, page: @slug), class: "btn btn-outline" %>
    <%= form_with url: review_admin_site_path(@version), method: :get, class: "studio-review-page" do |form| %>
      <%= form.label :page, "Page à vérifier" %>
      <%= form.select :page, @version.available_pages.map { |slug| [site_page_name(slug, @version), slug] }, { selected: @slug }, data: { action: "change->studio-review#page" } %>
      <noscript><button type="submit">Afficher cette page</button></noscript>
    <% end %>
    <div class="studio-review-sizes" aria-label="Largeur de l’aperçu">
      <div class="actions"><button type="button" data-action="studio-review#fit">Taille réelle</button><button type="button" data-width="1440" data-action="studio-review#preset">Ordinateur</button><button type="button" data-width="768" data-action="studio-review#preset">Tablette</button><button type="button" data-width="390" data-action="studio-review#preset">Téléphone</button></div>
      <label>Largeur <output data-studio-review-target="label"></output><input type="range" min="320" max="1920" step="1" aria-label="Largeur de l’aperçu en pixels" data-studio-review-target="slider" data-action="input->studio-review#resize"></label>
    </div>
    <% if @version.status == "published" %>
      <span class="badge">Cette version est en ligne</span>
    <% elsif @review_errors.empty? %>
      <%= button_to "Enregistrer et publier", publish_admin_site_path(@version), params: { digest: @version.digest, live_id: @live_version&.id, page: @slug }, class: "btn btn-primary" %>
    <% else %><span class="badge">Contenu à compléter avant publication</span><% end %>
    <% changes = site_review_changes(@version, @live_version) %>
    <% if changes.any? %><details class="studio-review-changes"><summary>Changements inclus</summary><ul><% changes.each do |change| %><li><%= change %></li><% end %></ul></details><% end %>
  </header>
  <% if @publication_error || @review_errors.any? %><div class="studio-review-errors" role="alert"><%= @publication_error %><% @review_errors.each do |error| %><p><%= error %></p><% end %></div><% end %>
  <section class="studio-review-stage" data-studio-review-target="stage" aria-label="Page en taille réelle">
    <iframe title="Résultat de vos modifications" src="<%= preview_admin_studio_path(@version, page: @slug, canvas: "1") %>" data-studio-review-target="frame"></iframe>
  </section>
</main>
