#!/usr/bin/env ruby
require "tmpdir"

Dir.chdir(File.expand_path("..", __dir__)) do
  Dir.mktmpdir("seos-ledger-check-") do |directory|
    environment = { "RAILS_ENV" => "test", "DATABASE_URL" => "sqlite3:#{directory}/check.sqlite3", "SEOS_CONCURRENCY_CHECK" => "1" }
    abort "Test database preparation failed" unless system(environment, "bin/rails", "db:prepare", out: File::NULL)
    abort "Ledger concurrency check failed" unless system(environment, "bin/rails", "runner", "scripts/check-ledger-concurrency.rb")
  end
end
