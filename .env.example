# Production: copy this file to .env at the repository root and fill every REPLACE value.
# Docker Compose reads .env automatically. Never commit the filled .env file.
# Development works without this file: SQLite and mail files in tmp/mail/ are the defaults.
# bin/dev does not load .env; export any optional development variables explicitly.

# PostgreSQL (production only)
POSTGRES_USER=seos
POSTGRES_DB=seos_production
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Generate a DIFFERENT value for each of these five secrets with: openssl rand -hex 32
# (database password above, Rails secret, and the three encryption keys below).
# Keep existing values when redeploying or restoring data.
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=REPLACE_WITH_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=REPLACE_WITH_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_WITH_ENCRYPTION_SALT

# Public HTTPS host, without protocol or path
SEOS_PUBLIC_HOST=seos.example.org
SEOS_ASSUME_SSL=true

# Sending email through the Gmail API (Google OAuth credentials, not random secrets)
# The sender must be the authorized mailbox or one of its authorized sender aliases.
SEOS_MAIL_FROM=your-mailbox@gmail.com
SEOS_MAIL_DELIVERY=gmail
GMAIL_CLIENT_ID=REPLACE_WITH_GMAIL_CLIENT_ID
GMAIL_CLIENT_SECRET=REPLACE_WITH_GMAIL_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=REPLACE_WITH_GMAIL_REFRESH_TOKEN

# Optional login with Google; separate from the Gmail delivery credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional map tile provider; {z}, {x}, {y} are substituted by Leaflet
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Needed only when reading secrets from encrypted Rails credentials
RAILS_MASTER_KEY=

# Optional process settings
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info
